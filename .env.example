# Word generation — server-side only. Never commit real values.
# The browser never sees these; they are read by the Worker (production) and by
# the Astro dev server (local). See README.md.

# An OpenAI-compatible chat-completions endpoint.
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# The API key for that endpoint. Use `wrangler secret put AI_API_KEY` in production.
AI_API_KEY=replace-me
# Optional model id; defaults to gpt-4o-mini.
AI_MODEL=gpt-4o-mini

# Cloudflare Turnstile — the human check shown once when `/play` opens.
# The site key is public; it is baked into the page (overridable at build time).
PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAFN0kO3hNISxwO9T
# Comma-separated hostnames accepted from siteverify. Local dev only; production
# sets this in wrangler.jsonc and must never include localhost.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# The widget secret used for server-side siteverify and to sign the 30-minute
# session. Use `wrangler secret put TURNSTILE_SECRET` in production. Never commit
# a real value.
TURNSTILE_SECRET=replace-me
