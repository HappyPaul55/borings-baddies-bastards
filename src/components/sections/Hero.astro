---
import type { SiteSettings } from "../../lib/site";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { ROLES, ROLE_ORDER } from "../../lib/game";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;

const stats = [
  {
    value: `${settings.playerMin}–${settings.playerMax}`,
    label: "players per game",
  },
  { value: "1", label: "phone, passed around" },
  { value: "Free", label: "no accounts, no ads" },
];

const tilt = ["-2.5deg", "1.5deg", "-1deg"];
---

<section
  class="on-ink grid-ink relative isolate overflow-hidden border-b border-line-ink bg-ink pt-[clamp(7rem,15vw,10rem)] pb-[clamp(3.5rem,8vw,6rem)]"
>
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="comment">
          <span class="slash" aria-hidden="true">//</span> social deduction ·
          pass the phone
        </p>

        <h1
          class="mt-5 font-display text-[clamp(2.5rem,7.2vw,5rem)] leading-[0.98] font-bold tracking-[-0.035em] text-cream"
        >
          One phone. One word. <span class="mark">Three</span> ways to lie.
        </h1>

        <p
          class="mt-6 max-w-[46rem] text-[clamp(1rem,1.5vw,1.18rem)] leading-[1.6] text-[rgba(250,250,244,0.72)]"
        >
          {settings.description}
        </p>

        <div class="no-print mt-8 flex flex-wrap items-center gap-3.5">
          <Button href="/play" variant="primary">
            Play now <span aria-hidden="true">→</span>
          </Button>
          <Button href="/rules" variant="outlineInk">How to play</Button>
        </div>

        <dl
          class="mt-[clamp(2.5rem,6vw,4rem)] grid grid-cols-1 gap-px overflow-hidden rounded-[6px] border border-line-ink bg-[rgba(250,250,244,0.08)] sm:grid-cols-3"
        >
          {
            stats.map((item) => (
              <div class="bg-ink px-5 py-5">
                <dt class="font-mono text-[0.68rem] font-bold tracking-[0.12em] text-[rgba(250,250,244,0.52)] uppercase">
                  {item.label}
                </dt>
                <dd class="mt-2 font-display text-[clamp(1.6rem,3vw,2.1rem)] leading-none font-bold text-yellow">
                  {item.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="relative mx-auto w-full max-w-[23rem]" aria-hidden="true">
        <div class="grid gap-4">
          {
            ROLE_ORDER.map((key, index) => {
              const role = ROLES[key];
              return (
                <div
                  class={`card card--${role.accent} bg-cream`}
                  style={`transform: rotate(${tilt[index]}); margin-inline-start: ${index * 0.75}rem;`}
                >
                  <div class="flex items-center justify-between gap-3">
                    <span class={`role-chip role-${role.accent}`}>
                      {role.seesWord ? "sees the word" : "blind"}
                    </span>
                    <span class="font-mono text-[0.62rem] font-bold tracking-[0.16em] text-muted">
                      ROLE {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <p
                    class={`mt-3 font-display text-[1.5rem] leading-none font-bold tracking-[-0.02em] role-${role.accent}`}
                  >
                    {role.name}
                  </p>
                  <p class="mt-2 text-[0.92rem] leading-[1.5] text-ink-soft">
                    {role.tagline}
                  </p>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </Container>
</section>
