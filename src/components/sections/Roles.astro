---
import Container from "../ui/Container.astro";
import { ROLES, ROLE_ORDER } from "../../lib/game";
---

<section
  id="roles"
  class="grid-paper scroll-mt-24 border-b border-line bg-paper py-[clamp(3.5rem,9vw,7rem)]"
>
  <Container>
    <p class="comment">
      <span class="slash" aria-hidden="true">//</span> 01 · the roles
    </p>
    <h2
      class="mt-4 max-w-[46rem] font-display text-[clamp(2rem,5vw,3.25rem)] leading-[1.02] font-bold tracking-[-0.03em]"
    >
      Everyone gets a secret, and none of them want the same thing.
    </h2>
    <p class="mt-5 max-w-[42rem] text-[clamp(1rem,1.4vw,1.12rem)] text-ink-soft">
      Three roles, one shared word (or not), and a room full of people bluffing
      badly. Boring players are in the majority — the others have to hide among
      them.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        ROLE_ORDER.map((key) => {
          const role = ROLES[key];
          return (
            <article class={`card card--${role.accent}`}>
              <span class={`role-chip role-${role.accent} self-start`}>
                {role.seesWord ? "sees the word" : "blind"}
              </span>
              <h3
                class={`mt-4 font-display text-[1.7rem] leading-none font-bold tracking-[-0.02em] role-${role.accent}`}
              >
                {role.name}
              </h3>
              <p class="mt-3 text-[0.98rem] leading-[1.6] text-ink-soft">
                {role.tagline}
              </p>
              <p class="mt-auto pt-5 font-mono text-[0.64rem] font-bold tracking-[0.14em] text-muted uppercase">
                Aim of the round
              </p>
              <p class="mt-1 text-[0.95rem] leading-[1.55]">{role.goal}</p>
            </article>
          );
        })
      }
    </div>
  </Container>
</section>
