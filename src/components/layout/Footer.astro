---
import type { SiteSettings } from "../../lib/site";
import Container from "../ui/Container.astro";
import Mark from "../ui/Mark.astro";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const year = new Date().getFullYear();
const domain = settings.url.replace(/^https?:\/\//, "").replace(/\/$/, "");

const nav = [
  { href: "/play", label: "Play" },
  { href: "/rules", label: "Rules" },
  { href: "/privacy", label: "Privacy" },
];

const link =
  "font-mono text-[0.78rem] font-bold uppercase tracking-[0.06em] text-[rgba(250,250,244,0.66)] transition-colors duration-200 ease-brand hover:text-yellow";
const heading =
  "font-mono text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[rgba(250,250,244,0.55)]";
---

<footer
  class="on-ink grid-ink border-t border-line-ink bg-ink pt-[clamp(3rem,7vw,5rem)] pb-8"
>
  <Container>
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a class="inline-flex items-center gap-[0.6rem]" href="/">
          <Mark size={30} />
          <span
            class="font-display text-[1.15rem] font-bold tracking-[-0.02em] text-cream"
            >{settings.name}</span
          >
        </a>
        <p
          class="mt-4 max-w-[24rem] text-[0.95rem] leading-[1.6] text-[rgba(250,250,244,0.62)]"
        >
          {settings.tagline}. Free to play in any modern browser — one phone,
          passed around the group.
        </p>
      </div>

      <nav aria-label="Footer" class="no-print">
        <h2 class={heading}>Pages</h2>
        <ul class="mt-4 grid gap-[0.7rem]">
          {
            nav.map((item) => (
              <li>
                <a class={link} href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="no-print">
        <h2 class={heading}>Elsewhere</h2>
        <ul class="mt-4 grid gap-[0.7rem]">
          <li>
            <a
              class={link}
              href={settings.repo}
              target="_blank"
              rel="noopener noreferrer">Source ↗</a
            >
          </li>
          <li>
            <a
              class={link}
              href={settings.licenseUrl}
              target="_blank"
              rel="noopener noreferrer">{settings.license} licence ↗</a
            >
          </li>
          <li>
            <a
              class={link}
              href={settings.authorUrl}
              target="_blank"
              rel="noopener noreferrer">HappyPaul55 ↗</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-[clamp(2.5rem,5vw,4rem)] flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line-ink pt-6 text-[0.78rem] text-[rgba(250,250,244,0.6)]"
    >
      <span
        >© {year}
        <a
          class="underline decoration-[rgba(250,250,244,0.35)] underline-offset-2 transition-colors duration-200 ease-brand hover:text-yellow"
          href={settings.authorUrl}
          target="_blank"
          rel="noopener noreferrer">{settings.author}</a
        >
        · {domain}</span
      >
      <span class="font-mono"
        >// no accounts, no cookies, no trackers</span
      >
    </div>
  </Container>
</footer>
